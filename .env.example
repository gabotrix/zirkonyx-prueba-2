# Copia este archivo como .env.local y completa los valores.
# Desde la etapa 2 DATABASE_URL es obligatoria para las reservas;
# las demás se dejan listas para las siguientes etapas.

# Etapa 2 · Reservas: conexión a PostgreSQL
# Ejemplo: postgres://usuario:clave@servidor:5432/sonrisaviva?sslmode=require
DATABASE_URL=

# Etapa 3 · Correos: proveedor de correo (SMTP o API) y buzón de la clínica
MAIL_FROM=
MAIL_API_KEY=
CLINIC_EMAIL=citas@sonrisaviva.co

# Etapa 4 · Acceso del equipo en /admin
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=
